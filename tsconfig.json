{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "skills/dstack/scripts/**/*.ts",
    "skills/dstack-init/scripts/**/*.ts",
    "skills/dstack-verify/scripts/**/*.ts"
  ]
}
